# FreshDash Mobile App Environment Configuration
# Override this variable to point to your backend API instance.
#
# Examples:
# - Development (Android Emulator loopback to host):
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# - Development (iOS Simulator / Web / Desktop):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
#
# - Development (Physical Android / iOS Device via Wi-Fi):
#   EXPO_PUBLIC_API_URL=http://192.168.1.35:8000/api/v1
#
# - Production (Live backend server — never use localhost in production):
#   EXPO_PUBLIC_API_URL=https://api.freshdash.com/api/v1
#
EXPO_PUBLIC_API_URL=
