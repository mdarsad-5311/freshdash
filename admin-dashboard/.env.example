# FreshDash Admin Dashboard - Environment Configuration Template

# API Base URL (Django REST Framework backend)
# Development (Local Django):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Production (PythonAnywhere):
# VITE_API_BASE_URL=https://mdarsad5311.pythonanywhere.com/api/v1

# Base asset path:
VITE_BASE_PATH=./

# Router mode: 'hash' for reliable static hosting without server rewrites, 'browser' for standard HTML5 routing
VITE_ROUTER_MODE=hash
